.env
*.env.local

# Generated by config-render from dynamic.yml.template
traefik/dynamic.yml

# TLS material + acme.sh state
traefik/certs/
*.crt
*.key
*.pem
acme.json

# MQTT credentials (ship an empty passwd; users are added at runtime)
mosquitto/passwd

# Runtime data / bind mounts.
# Anchored to the repo root on purpose, so they do not also match nested
# directories of the same name somewhere else in the tree.
/data/
/volumes/
/hassio/
/media/
*.log
.DS_Store

# Python bytecode / tool caches from scripts/
__pycache__/
*.pyc
.ruff_cache/
