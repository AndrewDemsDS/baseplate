.env
*.env.local

# Generated by config-render from dynamic.yml.template
traefik/dynamic.yml

# TLS material + acme.sh state
traefik/certs/
*.crt
*.key
*.pem
acme.json

# MQTT credentials (ship an empty passwd; users are added at runtime)
mosquitto/passwd

# Runtime data / bind mounts.
# Anchored to the repo root on purpose: an unanchored `media/` also matches
# `quadlet/media/` and silently drops those units from commits.
/data/
/volumes/
/hassio/
/media/
*.log
.DS_Store
