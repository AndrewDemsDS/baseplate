[Unit]
Description=baseplate: paperless_db

[Container]
ContainerName=paperless_db
Image=docker.io/postgres:17
Environment=POSTGRES_DB=paperless
Environment=POSTGRES_USER=paperless
Environment=POSTGRES_PASSWORD=${PAPERLESS_DB_PASSWORD}
Volume=paperless_db:/var/lib/postgresql/data
Network=baseplate_internal.network
NoNewPrivileges=true

[Service]
Restart=always

[Install]
WantedBy=default.target
