[Unit]
Description=baseplate: paperless
After=paperless_db.service
Requires=paperless_db.service
After=paperless_redis.service
Requires=paperless_redis.service

[Container]
ContainerName=paperless
Image=ghcr.io/paperless-ngx/paperless-ngx:latest
Environment=PAPERLESS_URL=https://paperless.${DOMAIN}
Environment=PAPERLESS_SECRET_KEY=${PAPERLESS_SECRET_KEY}
Environment=PAPERLESS_REDIS=redis://paperless_redis:6379
Environment=PAPERLESS_DBHOST=paperless_db
Environment=PAPERLESS_DBUSER=paperless
Environment=PAPERLESS_DBPASS=${PAPERLESS_DB_PASSWORD}
Environment=PAPERLESS_ADMIN_USER=${PAPERLESS_ADMIN_USER:-admin}
Environment=PAPERLESS_ADMIN_PASSWORD=${PAPERLESS_ADMIN_PASSWORD}
Volume=paperless_data:/usr/src/paperless/data
Volume=paperless_media:/usr/src/paperless/media
Network=proxy.network
Network=baseplate_internal.network
NoNewPrivileges=true

[Service]
Restart=always

[Install]
WantedBy=default.target
