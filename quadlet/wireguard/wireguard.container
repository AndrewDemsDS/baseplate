[Unit]
Description=baseplate: wireguard
RequiresMountsFor=/lib/modules

[Container]
ContainerName=wireguard
Image=lscr.io/linuxserver/wireguard:latest
Environment=SERVERURL=${WG_SERVER_HOSTNAME:-auto}
Environment=SERVERPORT=51820
Environment=PEERS=${WG_PEERS:-3}
Environment=PEERDNS=auto
Environment=INTERNAL_SUBNET=10.13.13.0
Environment=ALLOWEDIPS=0.0.0.0/0
Volume=wireguard_config:/config
Volume=/lib/modules:/lib/modules
PublishPort=51820:51820/udp
AddCapability=NET_ADMIN
AddCapability=SYS_MODULE
Sysctl=net.ipv4.conf.all.src_valid_mark=1
NoNewPrivileges=true

[Service]
Restart=always

[Install]
WantedBy=default.target
