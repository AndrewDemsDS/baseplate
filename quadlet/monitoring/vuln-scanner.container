[Unit]
Description=baseplate: vuln-scanner

[Container]
ContainerName=vuln-scanner
Image=docker.io/aquasec/trivy:latest
Entrypoint=/bin/sh /scan/vuln-scan.sh
Environment=RESEND_API_KEY=${RESEND_API_KEY:-}
Environment=ALERT_FROM=${ALERT_EMAIL:-you@example.com}
Environment=ALERT_EMAIL=${ALERT_EMAIL:-you@example.com}
Environment=SCAN_INTERVAL=${VULN_SCAN_INTERVAL:-604800}
Environment=TZ=${TZ:-UTC}
Volume=.:/stack:ro
Volume=${BASEPLATE_DIR}/scripts:/scan:ro
Volume=trivy_cache:/root/.cache
Network=proxy.network
NoNewPrivileges=true
PodmanArgs=--memory=1g

[Service]
Restart=always

[Install]
WantedBy=default.target
