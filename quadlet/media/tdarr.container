[Unit]
Description=baseplate: tdarr

[Container]
ContainerName=tdarr
Image=ghcr.io/haveagitgat/tdarr:latest
Environment=PUID=${PUID:-1000}
Environment=PGID=${PGID:-1000}
Environment=TZ=${TZ:-UTC}
Volume=tdarr_server:/app/server
Volume=tdarr_configs:/app/configs
Volume=tdarr_logs:/app/logs
Volume=media:/media
Volume=downloads:/temp
Network=proxy.network
NoNewPrivileges=true
PodmanArgs=--cpus=3.0

[Service]
Restart=always

[Install]
WantedBy=default.target
