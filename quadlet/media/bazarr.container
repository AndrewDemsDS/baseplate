[Unit]
Description=baseplate: bazarr

[Container]
ContainerName=bazarr
Image=lscr.io/linuxserver/bazarr:latest
Environment=PUID=${PUID:-1000}
Environment=PGID=${PGID:-1000}
Environment=TZ=${TZ:-UTC}
Volume=bazarr_config:/config
Volume=media:/media
Network=proxy.network
NoNewPrivileges=true

[Service]
Restart=always

[Install]
WantedBy=default.target
