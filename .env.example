# ─── baseplate / .env.example ──────────────────────────────────────────────────
# Copy this file to `.env`, fill in the values, then `docker compose up -d`.
# Never commit the real `.env`.

# ── Domain ─────────────────────────────────────────────────────────────────────
# Your root domain, managed by Cloudflare (the DNS-01 ACME challenge uses CF).
DOMAIN=example.com

# ── Cloudflare ─────────────────────────────────────────────────────────────────
# API token with: Zone → Zone → Read, Zone → DNS → Edit (scoped to your zone).
# Used by Traefik for the Let's Encrypt DNS-01 challenge.
CF_DNS_API_TOKEN=

# Account-scoped contact email for Let's Encrypt registration.
ACME_EMAIL=you@example.com

# ── Cloudflare Tunnel ──────────────────────────────────────────────────────────
# Token from Zero Trust → Networks → Tunnels → your tunnel → "Install connector".
# Tunnel must be remotely-managed (so you can edit Public Hostnames in the
# dashboard). Add Public Hostnames there pointing at http://traefik:80 or
# directly at container:port for each service.
CLOUDFLARED_TUNNEL_TOKEN=

# ── DDNS (optional) ────────────────────────────────────────────────────────────
# Only needed if you also want classic DDNS A-record updates (separate from
# the tunnel). Leave blank to disable that profile.
DDNS_API_KEY=
DDNS_SUBDOMAIN=

# ── Nextcloud ──────────────────────────────────────────────────────────────────
NEXTCLOUD_DB_PASSWORD=
NEXTCLOUD_DB_ROOT_PASSWORD=

# ── Vaultwarden ────────────────────────────────────────────────────────────────
# Argon2-hashed admin token recommended. Generate with:
#   docker run --rm vaultwarden/server:latest vaultwarden hash
VAULTWARDEN_ADMIN_TOKEN=

# ── Paperless-ngx ──────────────────────────────────────────────────────────────
PAPERLESS_DB_PASSWORD=
PAPERLESS_SECRET_KEY=
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=

# ── WireGuard ──────────────────────────────────────────────────────────────────
WG_PEERS=3
WG_SERVER_HOSTNAME=wg.example.com

# ── Home Assistant (assistant profile) ─────────────────────────────────────────
# Host path that holds your HA configuration (configuration.yaml, .storage, etc.).
# Defaults to ./hassio/config if unset.
HASS_CONFIG_DIR=./hassio/config
TZ=UTC
